{{/*
    The comments under a journal post. Posting one with HTMX returns to the
    post with the result, and the post answers with this fragment alone.

    @dot github.com/donseba/go-webthings/modules/publishing.Post
*/}}
<section class="narrow comments" id="remarks" aria-labelledby="comments-title">
    {{$count := commentCount "remarks" .ID}}
    <h2 id="comments-title">{{if $count}}{{tl localizer "Comments (%d)" $count}}{{else}}{{tl localizer "Comments"}}{{end}}</h2>

    {{range comments "remarks" .ID}}
        {{template "partials/comment.gohtml" .}}
    {{else}}
        <p class="meta">{{tl localizer "No comments yet. Be the first!"}}</p>
    {{end}}

    <div id="comment-form">
        {{with commentResult "remarks"}}
            <p class="notice" role="status">
                {{if eq . "sent"}}{{tl localizer "Thank you for your comment."}}
                {{else if eq . "pending"}}{{tl localizer "Thank you! Your comment appears once we have read it."}}
                {{else if eq . "closed"}}{{tl localizer "Comments are closed."}}
                {{else if eq . "throttled"}}{{tl localizer "You posted several comments already. Please try again later."}}
                {{else}}{{tl localizer "Please fill in your name and a comment."}}{{end}}
            </p>
        {{end}}

        {{if commentsClosed "remarks"}}
            <p class="meta">{{tl localizer "Comments are closed."}}</p>
        {{else}}
            {{/* The form and its fields with their limits come from the module (comments.PostInput); form_open adds go-partial's HTMX attributes to go-form's tag. */}}
            {{with commentInput "remarks" .ID}}
                {{form_open . "class" "comment-form" (submitAttrs runtime (commentURL "remarks") "target" "#remarks" "swap" "outerHTML")}}
                    <h3>{{tl localizer "Leave a comment"}}</h3>

                    {{form_field . "subject" nil}}
                    {{form_field . "name" nil}}
                    {{form_field . "email" nil}}
                    {{form_field . "body" nil}}

                    <p><button class="button" type="submit">{{tl localizer "Post comment"}}</button></p>
                {{form_close}}
            {{end}}
        {{end}}
    </div>
</section>
