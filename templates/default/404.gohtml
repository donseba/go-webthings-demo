{{/* @dot github.com/donseba/go-webthings/frontend.NotFound */}}
<main id="content" class="narrow">
    <p class="eyebrow">404</p>
    <h1>{{tl localizer "This page does not exist"}}</h1>
    <p class="lead">{{tl localizer "It may have moved, or it was never published."}}</p>
    <p><a class="button" href="{{.HomeURL}}">{{tl localizer "Back to the home page"}}</a></p>
</main>
