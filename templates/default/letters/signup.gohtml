{{/* @dot github.com/donseba/go-webthings/modules/newsletter.SignupView */}}
<main id="content" class="narrow">
    <h1>{{.Title}}</h1>

    {{with .Intro}}<div class="lead prose">{{.}}</div>{{end}}

    {{/* The form returns the visitor here, to the element with the id of the instance key. */}}
    <div id="{{.Key}}">
        {{if eq .Result "check-mail"}}
            <p class="notice" role="status">{{tl localizer "Almost done: check your inbox and confirm your subscription."}}</p>
        {{else if eq .Result "confirmed"}}
            <p class="notice" role="status">{{tl localizer "Your subscription is confirmed. Welcome!"}}</p>
        {{else if eq .Result "unsubscribed"}}
            <p class="notice" role="status">{{tl localizer "You are unsubscribed. Sorry to see you go."}}</p>
        {{else if eq .Result "invalid"}}
            <p class="notice" role="status">{{tl localizer "That did not work. Please check your e-mail address or link."}}</p>
        {{else if eq .Result "throttled"}}
            <p class="notice" role="status">{{tl localizer "Too many attempts. Please try again later."}}</p>
        {{end}}

        {{form_open .Form}}
            {{/* The fields and their limits come from the module (newsletter.SubscribeInput). */}}
            {{form_field .Form "locale" nil}}
            {{form_field .Form "email" nil}}
            {{form_field .Form "name" nil}}

            <p><button class="button" type="submit">{{tl localizer "Subscribe"}}</button></p>
            <p class="meta">{{tl localizer "You receive a mail to confirm your address. Every newsletter has a link to unsubscribe."}}</p>
        {{form_close}}
    </div>
</main>
