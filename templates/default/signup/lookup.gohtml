{{/* @dot github.com/donseba/go-webthings/modules/registrations.LookupView */}}
<main id="content" class="narrow">
    <h1>{{.Title}}</h1>
    <p class="lead">{{tl localizer "Enter the code from your confirmation mail to see or cancel your booking."}}</p>

    {{if .NotFound}}
        <p class="notice" role="status">{{tl localizer "We could not find a booking with the code %s." .Code}}</p>
    {{end}}

    {{form_open .Form}}
        {{/* The code with its limits from the module (registrations.LookupInput). */}}
        {{form_field .Form "code" nil}}

        <p><button class="button" type="submit">{{tl localizer "Look up"}}</button></p>
    {{form_close}}

    {{with moduleURL "workshops"}}<p><a href="{{.}}">← {{tl localizer "All workshops"}}</a></p>{{end}}
</main>
