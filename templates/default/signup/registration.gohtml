{{/* @dot github.com/donseba/go-webthings/modules/registrations.RegistrationView */}}
<main id="content" class="narrow">
    <p class="meta">{{.Title}}</p>
    <h1>{{.Subject.Title}}</h1>

    {{if eq .Result "registered"}}
        <p class="notice" role="status">{{tl localizer "Thank you, you are signed up. We sent you a confirmation."}}</p>
    {{else if eq .Result "cancelled"}}
        <p class="notice" role="status">{{tl localizer "Your booking is cancelled."}}</p>
    {{end}}

    {{/* When the event takes place; zero for other subjects. */}}
    {{if not .Subject.When.IsZero}}
        <p class="lead">{{template "partials/when.gohtml" .Subject.When}}</p>
    {{end}}

    <dl class="facts card">
        <dt>{{tl localizer "Booking code"}}</dt>
        <dd><strong>{{.Code}}</strong></dd>

        <dt>{{tl localizer "Name"}}</dt>
        <dd>{{.Name}}</dd>

        <dt>{{tl localizer "Adults"}}</dt>
        <dd>{{.Adults}}</dd>

        {{if .Children}}
            <dt>{{tl localizer "Children"}}</dt>
            <dd>{{.Children}}</dd>
        {{end}}

        {{if .Total}}
            <dt>{{tl localizer "Total"}}</dt>
            <dd>
                {{money .Total .Currency}}
                {{if eq .Payment "paid"}}· {{tl localizer "paid"}}
                {{else if eq .Payment "pending"}}· {{tl localizer "not paid yet"}}
                {{else if eq .Payment "cancelled"}}· {{tl localizer "cancelled"}}{{end}}
            </dd>
        {{end}}

        {{with .Notes}}
            <dt>{{tl localizer "Your remarks"}}</dt>
            <dd>{{.}}</dd>
        {{end}}

        <dt>{{tl localizer "Booked on"}}</dt>
        <dd>{{date .CreatedAt}}</dd>
    </dl>

    {{with .PaymentLink}}<p><a class="button" href="{{.}}"{{noBoost runtime}}>{{tl localizer "Pay now"}}</a></p>{{end}}
    {{.Info}}

    {{if .Cancelled}}
        <p class="notice">{{tl localizer "This booking is cancelled."}}</p>
    {{else}}
        {{/* The cancel form returns the visitor here, to the element with the id of the instance key, open after a failed attempt. */}}
        <details class="cancel" id="{{.Key}}"{{if or (eq .Result "invalid") (eq .Result "throttled")}} open{{end}}>
            <summary>{{tl localizer "Cancel this booking"}}</summary>

            {{if eq .Result "invalid"}}
                <p class="notice" role="status">{{tl localizer "That e-mail address does not match this booking."}}</p>
            {{else if eq .Result "throttled"}}
                <p class="notice" role="status">{{tl localizer "Too many attempts. Please try again later."}}</p>
            {{end}}

            {{form_open .Form}}
                {{/* The code and the e-mail address with their limits from the module (registrations.CancelInput). */}}
                {{form_field .Form "code" nil}}
                {{form_field .Form "email" nil}}

                <p><button class="button ghost" type="submit">{{tl localizer "Cancel booking"}}</button></p>
            {{form_close}}
        </details>
    {{end}}
</main>
