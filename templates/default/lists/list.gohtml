{{/* @dot github.com/donseba/go-webthings/modules/lists.ListView */}}
<main id="content">
    {{if eq .Key "faq"}}
        <div class="narrow faq">
            <h1>{{.Title}}</h1>
            {{range .Entries}}
                <details id="{{.ID}}">
                    <summary>{{.Title}}</summary>
                    <div class="answer prose">{{.Body}}</div>
                </details>
            {{end}}
        </div>
    {{else}}
        <div class="wrap">
            <h1>{{.Title}}</h1>
            <ol class="service-rows" role="list">
                {{range .Entries}}
                    <li class="service-row" id="{{.ID}}">
                        {{if .ImageURL}}<img src="{{.ImageURL}}" srcset="{{.ImageSrcset}}" sizes="(max-width: 900px) 100vw, 50vw" alt="" loading="lazy">{{end}}
                        <div class="service-row-text">
                            <h2>{{.Title}}</h2>
                            <div class="prose">{{.Body}}</div>
                            {{if .Link}}<p><a class="more" href="{{.Link}}">{{tl localizer "Read more"}} →</a></p>{{end}}
                        </div>
                    </li>
                {{end}}
            </ol>

            {{with documents "downloads" 3}}
                <section class="section">
                    <div class="section-head">
                        <h2>{{tl localizer "Downloads"}}</h2>
                        {{with moduleURL "downloads"}}<a href="{{.}}">{{tl localizer "All downloads"}} →</a>{{end}}
                    </div>
                    <div class="documents">
                        {{range .}}{{template "partials/document-row.gohtml" .}}{{end}}
                    </div>
                </section>
            {{end}}
        </div>
    {{end}}
</main>
